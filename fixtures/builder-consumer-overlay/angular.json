{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm"
  },
  "projects": {
    "minimal": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@neolorn/thoth-toolkit:build",
          "options": {
            "buildTarget": "minimal:angular-build"
          },
          "configurations": {
            "production": {
              "buildTarget": "minimal:angular-build:production"
            },
            "development": {
              "buildTarget": "minimal:angular-build:development",
              "pseudoLocales": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@neolorn/thoth-toolkit:serve",
          "options": {
            "serveTarget": "minimal:angular-serve",
            "pseudoLocales": true
          }
        },
        "test": {
          "builder": "@neolorn/thoth-toolkit:test",
          "options": {
            "testTarget": "minimal:angular-test",
            "pseudoLocales": true
          }
        },
        "angular-build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": [
              {
                "glob": "arrival.txt",
                "input": "public"
              }
            ],
            "polyfills": ["thoth-condition-probe"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1kB"
                }
              ],
              "sourceMap": {
                "scripts": true,
                "styles": false,
                "vendor": true,
                "hidden": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "angular-serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "minimal:angular-build:development",
            "port": 0,
            "headers": {
              "X-Thoth-Arrival": "angular-serve"
            }
          }
        },
        "angular-test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "minimal:angular-build:development",
            "setupFiles": ["src/setup-arrival.ts"],
            "runnerConfig": true
          }
        }
      }
    }
  }
}
